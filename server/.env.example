# Server port.
PORT=5000

# MongoDB connection string. Use a local mongod for development
# (mongodb://127.0.0.1:27017/shadematch) or a MongoDB Atlas URI in production.
MONGO_URI=

# Secret used to sign JWTs. Generate a long random value — never reuse
# across environments. (Auth is scaffolded but not yet wired into any
# route; this is reserved for when it is.)
JWT_SECRET=

# Origin allowed by CORS — the deployed frontend URL in production.
CLIENT_URL=http://localhost:5173

# Base URL of the Python/FastAPI ML service.
ML_SERVICE_URL=http://localhost:8000

# Used only for Part 9 shade-chart label extraction (server-side only —
# never exposed to the frontend). Leave blank to disable that feature;
# every other feature works without it.
OPENAI_API_KEY=
# Optional: override the default vision model (gpt-4o-mini).
OPENAI_VISION_MODEL=

# Cloudinary credentials for client photo and shade-chart image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
